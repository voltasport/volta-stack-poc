# Copy to .env.local (gitignored). Never commit real values to the public repo.

DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/portal
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for `npm run db:seed-users` and local validation scripts only.
SEED_ADMIN_PASSWORD=
SEED_DIRECTOR_PASSWORD=
SEED_MANAGER_PASSWORD=

# Onboarding E2E (`node scripts/onboarding-e2e.mjs`) — local DB only.
ONBOARDING_E2E_BEN_EMAIL=ben@andcollar.com
ONBOARDING_E2E_BEN_NAME=Ben Andcollar
ONBOARDING_E2E_BEN_PASSWORD=

# Invite email (Resend). When both are set, portal sends invite and password-reset emails.
# When unset, production logs a short summary to the server console; non-production may write
# HTML previews to portal/.data/email-previews/ (try/catch). Admins copy invite links on Users.
RESEND_API_KEY=
INVITE_FROM_EMAIL="Volta Portal <portal@voltasport.co>"
PORTAL_SUPPORT_EMAIL=support@voltasport.co
# Optional copy for invite templates (hours).
INVITE_LINK_EXPIRY_HOURS=24
